# LyRead 环境变量模板（复制到服务器 /tmp/lyread.env 并填入真实值，勿提交仓库）

APP_ENV=production
APP_VERSION=1.9.1
SITE_URL=https://lyread.cn

# MySQL
MYSQL_HOST=lyread-mysql
MYSQL_PORT=3306
MYSQL_USER=lyread
MYSQL_PASSWORD=
MYSQL_DATABASE=lyread

# Auth
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=https://lyread.cn,https://www.lyread.cn
ADMIN_USERNAMES=user001

# AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# SMTP（腾讯企业邮示例）
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_TLS=0
SMTP_USER=noreply@lyread.cn
SMTP_PASSWORD=
SMTP_FROM=noreply@lyread.cn

# 支付宝
ALIPAY_SANDBOX=1
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://lyread.cn/api/orders/alipay/notify
ALIPAY_RETURN_URL=https://lyread.cn/wallet

# 无邮件时的密码重置回退
EXPOSE_RESET_TOKEN=1

# 前端分析（构建时注入 Vite，见 frontend/.env.production.example）
VITE_BAIDU_TONGJI_ID=
VITE_GA4_MEASUREMENT_ID=

# 服务器上可复制为 /tmp/lyread-frontend.env，deploy.sh 构建时自动加载

# 调度
AUTO_EVOLUTION=1
EVOLUTION_INTERVAL_SECONDS=900
MAX_CONCURRENT_JOBS=2
